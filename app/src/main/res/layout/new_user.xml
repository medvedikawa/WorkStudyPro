<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ws_surface">

    <!-- Scrollable Content Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavContainer"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="19dp">

            <!-- 1. Header with Profile Initial -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wednesday, Oct 14"
                        android:textStyle="bold"
                        android:textColor="@color/ws_text"
                        android:textSize="11sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today"
                        android:textColor="@color/ws_text"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Profile Initials Badge -->
                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:text="🔔"
                    android:textColor="@color/ws_accent2"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Weekly At-A-Glance Day Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">


                <TextView android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_input" android:gravity="center" android:text="Su\n🟢" android:textColor="@color/ws_text" android:textSize="9sp"/>
                <TextView android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_input" android:gravity="center" android:text="M\n🟢" android:textColor="@color/ws_text" android:textSize="9sp"/>
                <TextView android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_input" android:gravity="center" android:text="T\n🟢" android:textColor="@color/ws_text" android:textSize="9sp"/>
                <TextView android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_input" android:gravity="center" android:text="W\n🟢" android:textColor="@color/ws_text" android:textSize="9sp"/>
                <TextView android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_input" android:gravity="center" android:text="Th\n🟢" android:textColor="@color/ws_text" android:textSize="9sp"/>
                <TextView android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_input" android:gravity="center" android:text="F\n🟢" android:textColor="@color/ws_text" android:textSize="9sp"/>
                <TextView android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/bg_input" android:gravity="center" android:text="Sa\n🟢" android:textColor="@color/ws_text" android:textSize="9sp"/>
            </LinearLayout>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:layout_marginEnd="10dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wow, your schedule looks emtpy"
                        android:textColor="@color/ws_muted"
                        android:textSize="30sp"
                        android:gravity="center"
                        />

                </LinearLayout>
            </LinearLayout>











        </LinearLayout>
    </ScrollView>

    <!-- 7. Bottom Navigation Bar with Floating Action Button[cite: 2] -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="@color/ws_surface"
        android:orientation="horizontal"
        android:gravity="center"
        android:elevation="8dp">

        <TextView
            android:id="@+id/btnToday"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🐸\nToday"
            android:textColor="@color/ws_accent"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnWeek"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🐷\nWeek"
            android:textColor="@color/ws_text"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Central Scan Schedule Button (Perfect Circle & Larger Icon) -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/fabScanSchedule"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_accent_cirlce"
                android:src="@drawable/scann"
                app:tint="@color/ws_accent"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:contentDescription="Scan Schedule Camera" />
        </FrameLayout>

        <TextView
            android:id="@+id/btnTasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🐰\nTasks"
            android:textColor="@color/ws_text"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />


        <TextView
            android:id="@+id/btnYou"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🦈\nYou"
            android:textColor="@color/ws_text"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</RelativeLayout>