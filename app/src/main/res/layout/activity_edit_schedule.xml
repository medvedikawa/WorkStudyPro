<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Header Bar -->
    <LinearLayout
        android:id="@+id/editScheduleHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/surface">

        <ImageButton
            android:id="@+id/btnReturnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/back_arrow"
            app:tint="@color/ws_accent"
            android:contentDescription="Back"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/tvScheduleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verify &amp; Add Schedule"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScheduleSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adjust detected subjects, times, and day assignments."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scanned Image Thumbnail Preview Card -->
    <LinearLayout
        android:id="@+id/layoutScannedPreviewCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/editScheduleHeader"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_input"
        android:padding="10dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivScannedThumbnail"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_card" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cropped Schedule Image"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verify scanned text below against your source."
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnReCrop"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="⛶ Re-Crop"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/ws_accent"
            android:backgroundTint="@color/ws_surface2"
            android:paddingHorizontal="10dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <!-- Scrollable Content Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutScannedPreviewCard"
        android:layout_above="@id/layoutBottomActions"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Scan Warning Banner -->
            <TextView
                android:id="@+id/tvScanWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ Some classes may be missing"
                android:textColor="@color/brand_raspberry"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_input"
                android:padding="10dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- Time Slots RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTimeSlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Skipped Lines ("Lines we couldn't place") Card -->
            <LinearLayout
                android:id="@+id/layoutSkippedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSkippedHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lines we couldn't place ▾"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:paddingBottom="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <LinearLayout
                    android:id="@+id/layoutSkippedContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Bottom Actions: Add Slot & Save Schedule -->
    <LinearLayout
        android:id="@+id/layoutBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/surface"
        android:elevation="8dp">

        <TextView
            android:id="@+id/btnAddTimeSlot"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="+ Add Another Time Slot"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_input"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnSaveSchedule"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Save Schedule"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/ws_on_brand"
            android:backgroundTint="@color/ws_accent" />
    </LinearLayout>

</RelativeLayout>
