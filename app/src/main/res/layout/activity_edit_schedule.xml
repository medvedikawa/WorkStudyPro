<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#0D0F14"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="20dp">


    <ImageButton
        android:id="@+id/btnReturnBack"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/back_arrow"
        app:tint="@color/ws_accent"
        android:contentDescription="Return back"
        android:scaleType="centerInside" />

    <!-- Header Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Review &amp; Edit Schedule"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verify scanned details and adjust meeting times."
        android:textColor="#8A92A6"
        android:textSize="14sp"
        android:layout_marginBottom="20dp" />


    <!-- Time Slots Section Header + Add Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Meeting Days &amp; Times"
            android:textColor="#C5CBD3"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAddTimeSlot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add Slot"
            android:textColor="#FF6B47"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="4dp" />
    </LinearLayout>

    <!-- RecyclerView for Multiple Time Slots -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTimeSlots"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp" />

    <!-- Save & Check Button -->
    <Button
        android:id="@+id/btnSaveSchedule"
        android:layout_width="wrap_content"
        android:layout_height="54dp"
        android:backgroundTint="#FF6B47"
        android:text="Save"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>