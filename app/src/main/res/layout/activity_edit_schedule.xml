<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollContent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:id="@+id/editScheduleHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:background="@color/surface">
        <ImageButton
            android:id="@+id/btnReturnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/back_arrow"
            app:tint="@color/ws_accent"
            android:contentDescription="Back"
            android:scaleType="centerInside" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">
            <TextView
                android:id="@+id/tvScheduleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Review schedule"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvScheduleSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check your classes and times before saving."
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutScannedPreviewCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_schedule_photo_card"
        android:padding="10dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/ivScannedThumbnail"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_schedule_photo_thumb"
            android:contentDescription="Scanned schedule preview" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Schedule photo"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap the photo to enlarge and compare."
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>
        <Button
            android:id="@+id/btnReCrop"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Re-crop"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/ws_accent"
            android:backgroundTint="@color/ws_surface2"
            android:paddingHorizontal="10dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutScheduleTabs"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="3dp"
        android:paddingBottom="5dp">
        <LinearLayout
            android:id="@+id/btnSchoolTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/bg_schedule_tab_selected"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/ivSchoolIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_schedule_school_selected"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/tvSchoolText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="School"
                android:textStyle="bold"
                android:textColor="@color/ws_on_brand" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnWorkTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/bg_schedule_tab_unselected"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/ivWorkIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_schedule_work"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/tvWorkText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Work"
                android:textStyle="bold"
                android:textColor="@color/text_muted" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvScheduleTabHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="5dp"
        android:text="School and work times are checked against each other for conflicts."
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvConflictBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="2dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:drawableStart="@drawable/ic_schedule_warning"
        android:textColor="@color/brand_raspberry"
        android:textSize="12sp"
        android:drawablePadding="6dp"
        android:background="@drawable/bg_schedule_conflict"
        android:visibility="gone" />
    <TextView
        android:id="@+id/btnJumpToConflict"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_gravity="end"
        android:layout_marginHorizontal="24dp"
        android:drawableStart="@drawable/ic_schedule_jump"
        android:drawablePadding="5dp"
        android:text="Go to first conflict"
        android:textColor="@color/ws_accent"
        android:textStyle="bold"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />
    <TextView
        android:id="@+id/tvCrossTabWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="4dp"
        android:padding="8dp"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:background="@drawable/bg_schedule_warning"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutFilterChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="2dp"
        android:paddingBottom="5dp">
        <TextView
            android:id="@+id/filterAll"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="All"
            android:textColor="@color/ws_on_brand"
            android:background="@drawable/bg_schedule_filter_selected"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/filterConflicts"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Conflicts"
            android:textColor="@color/text_muted"
            android:background="@drawable/bg_schedule_filter_unselected"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/filterCheck"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Check"
            android:textColor="@color/text_muted"
            android:background="@drawable/bg_schedule_filter_unselected"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/filterOk"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="OK"
            android:textColor="@color/text_muted"
            android:background="@drawable/bg_schedule_filter_unselected"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvScanWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Some classes may be missing."
        android:textColor="@color/brand_raspberry"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_input"
        android:padding="8dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="14dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTimeSlots"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:id="@+id/layoutBottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:background="@color/surface"
        android:elevation="8dp">
        <Button
            android:id="@+id/btnAddScheduleEntry"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:drawableStart="@drawable/ic_schedule_add"
            android:drawablePadding="6dp"
            android:text="Add schedule entry"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/ws_accent"
            android:backgroundTint="@color/ws_surface2" />
        <Button
            android:id="@+id/btnSaveSchedule"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Save School Schedule"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/ws_on_brand"
            android:backgroundTint="@color/ws_accent" />
    </LinearLayout>
</LinearLayout>
