<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/today_glow_height"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_today_glow"
        android:clickable="false"
        android:focusable="false" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/today_screen_horizontal"
            android:paddingTop="@dimen/today_screen_top"
            android:paddingEnd="@dimen/today_screen_horizontal"
            android:paddingBottom="@dimen/today_screen_bottom">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/today_header_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDateHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/WS.Caption" />

                    <TextView
                        android:id="@+id/tvWelcomeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/today_header_text_gap"
                        android:textAppearance="@style/WS.Title" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="@dimen/today_notification_size"
                    android:layout_height="@dimen/today_notification_size"
                    android:background="@drawable/bg_today_notification">

                    <ImageView
                        android:id="@+id/btnQuickNotification"
                        android:layout_width="@dimen/today_notification_icon_size"
                        android:layout_height="@dimen/today_notification_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@string/today_notification_content_description"
                        android:src="@drawable/ic_today_notifications" />
                </FrameLayout>
            </LinearLayout>

            <!-- Week Calendar Strip (Section A) -->
            <LinearLayout
                android:id="@+id/layoutWeekStrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal"
                android:weightSum="7">

                <!-- Chip 0 (Su) -->
                <LinearLayout
                    android:id="@+id/chipDay0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_calendar_chip_normal"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="7dp">

                    <TextView
                        android:id="@+id/tvChipDay0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Su"
                        android:textAppearance="@style/WS.Micro" />

                    <TextView
                        android:id="@+id/tvChipDate0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="25"
                        android:textAppearance="@style/WS.CardTitle" />

                    <View
                        android:id="@+id/vChipDot0"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/ic_dot_indicator"
                        android:visibility="invisible" />
                </LinearLayout>

                <!-- Chip 1 (Mo) -->
                <LinearLayout
                    android:id="@+id/chipDay1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_calendar_chip_normal"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="7dp">

                    <TextView
                        android:id="@+id/tvChipDay1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mo"
                        android:textAppearance="@style/WS.Micro" />

                    <TextView
                        android:id="@+id/tvChipDate1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="26"
                        android:textAppearance="@style/WS.CardTitle" />

                    <View
                        android:id="@+id/vChipDot1"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/ic_dot_indicator"
                        android:visibility="invisible" />
                </LinearLayout>

                <!-- Chip 2 (Tu) -->
                <LinearLayout
                    android:id="@+id/chipDay2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_calendar_chip_normal"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="7dp">

                    <TextView
                        android:id="@+id/tvChipDay2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tu"
                        android:textAppearance="@style/WS.Micro" />

                    <TextView
                        android:id="@+id/tvChipDate2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="27"
                        android:textAppearance="@style/WS.CardTitle" />

                    <View
                        android:id="@+id/vChipDot2"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/ic_dot_indicator"
                        android:visibility="invisible" />
                </LinearLayout>

                <!-- Chip 3 (We) -->
                <LinearLayout
                    android:id="@+id/chipDay3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_calendar_chip_normal"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="7dp">

                    <TextView
                        android:id="@+id/tvChipDay3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="We"
                        android:textAppearance="@style/WS.Micro" />

                    <TextView
                        android:id="@+id/tvChipDate3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="28"
                        android:textAppearance="@style/WS.CardTitle" />

                    <View
                        android:id="@+id/vChipDot3"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/ic_dot_indicator"
                        android:visibility="invisible" />
                </LinearLayout>

                <!-- Chip 4 (Th) -->
                <LinearLayout
                    android:id="@+id/chipDay4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_calendar_chip_normal"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="7dp">

                    <TextView
                        android:id="@+id/tvChipDay4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Th"
                        android:textAppearance="@style/WS.Micro" />

                    <TextView
                        android:id="@+id/tvChipDate4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="29"
                        android:textAppearance="@style/WS.CardTitle" />

                    <View
                        android:id="@+id/vChipDot4"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/ic_dot_indicator"
                        android:visibility="invisible" />
                </LinearLayout>

                <!-- Chip 5 (Fr) -->
                <LinearLayout
                    android:id="@+id/chipDay5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_calendar_chip_normal"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="7dp">

                    <TextView
                        android:id="@+id/tvChipDay5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fr"
                        android:textAppearance="@style/WS.Micro" />

                    <TextView
                        android:id="@+id/tvChipDate5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="30"
                        android:textAppearance="@style/WS.CardTitle" />

                    <View
                        android:id="@+id/vChipDot5"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/ic_dot_indicator"
                        android:visibility="invisible" />
                </LinearLayout>

                <!-- Chip 6 (Sa) -->
                <LinearLayout
                    android:id="@+id/chipDay6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_calendar_chip_normal"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="7dp">

                    <TextView
                        android:id="@+id/tvChipDay6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sa"
                        android:textAppearance="@style/WS.Micro" />

                    <TextView
                        android:id="@+id/tvChipDate6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="31"
                        android:textAppearance="@style/WS.CardTitle" />

                    <View
                        android:id="@+id/vChipDot6"
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/ic_dot_indicator"
                        android:visibility="invisible" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutWorkloadCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/today_card_gap"
                android:background="@drawable/bg_today_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/today_card_horizontal_padding"
                android:paddingTop="@dimen/today_card_vertical_padding"
                android:paddingEnd="@dimen/today_card_horizontal_padding"
                android:paddingBottom="@dimen/today_card_vertical_padding"
                android:visibility="gone">

                <!-- Row 1: Left "This week" in WS.Caption, Right Load Band Chip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="This week"
                        android:textAppearance="@style/WS.Caption" />

                    <TextView
                        android:id="@+id/tvWorkloadStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_load_band_purple"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/brand_purple"
                        android:textAppearance="@style/WS.Micro" />
                </LinearLayout>

                <!-- Row 2: 6dp below, baseline aligned: 34sp Bold hours, 6dp gap, "of {limit} hrs" in WS.Value -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:baselineAligned="true"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvWorkloadNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="38"
                        android:textAppearance="@style/WS.LoadNumber" />

                    <TextView
                        android:id="@+id/tvWorkloadLimit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="of 45 hrs"
                        android:textAppearance="@style/WS.Value" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressWeeklyLoad"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/today_load_progress_height"
                    android:layout_marginTop="10dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_today_load" />

                <TextView
                    android:id="@+id/tvWorkloadHours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/WS.Caption" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutConflictCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/today_card_gap"
                android:background="@drawable/bg_today_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/today_card_horizontal_padding"
                android:paddingTop="@dimen/today_card_vertical_padding"
                android:paddingEnd="@dimen/today_card_horizontal_padding"
                android:paddingBottom="@dimen/today_card_vertical_padding"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvConflictHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/WS.CardTitle"
                    android:textColor="@color/brand_raspberry" />

                <TextView
                    android:id="@+id/tvConflictDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/today_header_text_gap"
                    android:textAppearance="@style/WS.Caption" />

                <TextView
                    android:id="@+id/btnSuggestAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/today_empty_button_gap"
                    android:text="@string/today_review_conflict"
                    android:textAppearance="@style/WS.Link" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardFocusTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/today_card_gap"
                android:background="@drawable/bg_today_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/today_card_horizontal_padding"
                android:paddingTop="@dimen/today_card_vertical_padding"
                android:paddingEnd="@dimen/today_card_horizontal_padding"
                android:paddingBottom="@dimen/today_card_vertical_padding"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/today_section_header_bottom"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/today_focus_title"
                        android:textAppearance="@style/WS.CardTitle" />

                    <LinearLayout
                        android:id="@+id/btnViewAllTasks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/today_see_all"
                            android:textAppearance="@style/WS.Link" />

                        <ImageView
                            android:layout_width="@dimen/today_link_icon_size"
                            android:layout_height="@dimen/today_link_icon_size"
                            android:layout_marginStart="@dimen/today_link_icon_gap"
                            android:contentDescription="@string/today_arrow_content_description"
                            android:src="@drawable/ic_today_arrow_forward" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerPriorityTasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/layoutEmptyTasksPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="@dimen/today_empty_content_min_height"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/today_empty_tasks_title"
                        android:textAppearance="@style/WS.Item" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/today_header_text_gap"
                        android:text="@string/today_empty_tasks_body"
                        android:textAppearance="@style/WS.Caption" />

                    <LinearLayout
                        android:id="@+id/btnHomeAddTask"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/today_empty_button_gap"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/today_empty_add_icon_size"
                            android:layout_height="@dimen/today_empty_add_icon_size"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_today_add" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/today_add_task"
                            android:textAppearance="@style/WS.Link" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardTodaySchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_today_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/today_card_horizontal_padding"
                android:paddingTop="@dimen/today_card_vertical_padding"
                android:paddingEnd="@dimen/today_card_horizontal_padding"
                android:paddingBottom="@dimen/today_card_vertical_padding"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/today_section_header_bottom"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/today_schedule_title"
                        android:textAppearance="@style/WS.CardTitle" />

                    <LinearLayout
                        android:id="@+id/btnViewWeekSchedule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/today_full_week"
                            android:textAppearance="@style/WS.Link" />

                        <ImageView
                            android:layout_width="@dimen/today_link_icon_size"
                            android:layout_height="@dimen/today_link_icon_size"
                            android:layout_marginStart="@dimen/today_link_icon_gap"
                            android:contentDescription="@string/today_arrow_content_description"
                            android:src="@drawable/ic_today_arrow_forward" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerTodaySchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/layoutEmptySchedulePlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="@dimen/today_empty_content_min_height"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/today_empty_schedule_title"
                        android:textAppearance="@style/WS.Item" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/today_header_text_gap"
                        android:text="@string/today_empty_schedule_body"
                        android:textAppearance="@style/WS.Caption" />

                    <TextView
                        android:id="@+id/btnHomeAddSchedule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/today_empty_button_gap"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/today_scan_schedule"
                        android:textAppearance="@style/WS.Link" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/today_nav_height"
        android:layout_gravity="bottom" />
</FrameLayout>
