<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ws_bg"
    android:fillViewport="true"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btnReturnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Return back"
            android:scaleType="centerInside"
            android:src="@drawable/back_arrow"
            app:tint="@color/ws_accent" />

        <!-- Header -->
        <TextView
            android:id="@+id/tvStepIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.1"
            android:text="STEP 1 OF 3"
            android:textColor="@color/ws_accent"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvForgotTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:text="Reset Password"
            android:textColor="@color/ws_text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvForgotSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:lineSpacingExtra="2dp"
            android:text="Enter your registered email address to receive a recovery code."
            android:textColor="@color/ws_muted"
            android:textSize="13sp" />

        <!-- Progress Step Indicator Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/stepBar1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_strength_bar_segment"
                android:backgroundTint="@color/ws_accent" />

            <View
                android:id="@+id/stepBar2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_strength_bar_segment"
                android:backgroundTint="@color/ws_border" />

            <View
                android:id="@+id/stepBar3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_strength_bar_segment"
                android:backgroundTint="@color/ws_border" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- STATE 1: ENTER EMAIL -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layoutStateEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.08"
                android:text="EMAIL ADDRESS"
                android:textColor="@color/ws_text2"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etForgotEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_input"
                android:hint="student@university.edu"
                android:inputType="textEmailAddress"
                android:padding="13dp"
                android:textColor="@color/ws_text"
                android:textColorHint="@color/ws_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvEmailError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="16dp"
                android:textColor="@color/ws_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSendEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/ws_accent"
                android:padding="14dp"
                android:text="Send Recovery Code"
                android:textColor="@color/ws_on_brand"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBackToLogin1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:padding="8dp"
                android:text="Remember your password? Log in"
                android:textColor="@color/ws_accent"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- STATE 2: ENTER CODE -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layoutStateCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Target Email badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvTargetEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="user@example.com"
                    android:textColor="@color/ws_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChangeEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="Change"
                    android:textColor="@color/ws_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.08"
                android:text="6-DIGIT VERIFICATION CODE"
                android:textColor="@color/ws_text2"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Reusable Code Input View -->
            <com.example.wspro.CodeInputView
                android:id="@+id/codeInputView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tvCodeError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="16dp"
                android:textColor="@color/ws_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Resend Code Cooldown Link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Didn't receive the code? "
                    android:textColor="@color/ws_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvResendCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="Resend code in 30s"
                    android:textColor="@color/ws_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnVerifyCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/ws_accent"
                android:padding="14dp"
                android:text="Verify Code"
                android:textColor="@color/ws_on_brand"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- STATE 3: NEW PASSWORD -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layoutStatePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- New Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.08"
                android:text="NEW PASSWORD"
                android:textColor="@color/ws_text2"
                android:textSize="10sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp">

                <EditText
                    android:id="@+id/etNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:hint="Min. 8 characters"
                    android:inputType="textPassword"
                    android:padding="13dp"
                    android:paddingEnd="46dp"
                    android:textColor="@color/ws_text"
                    android:textColorHint="@color/ws_muted"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnToggleNewPassword"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle password visibility"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_eye" />
            </FrameLayout>

            <!-- Password Strength Bar & Label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/strengthBar1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_strength_bar_segment" />

                    <View
                        android:id="@+id/strengthBar2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_strength_bar_segment" />

                    <View
                        android:id="@+id/strengthBar3"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_strength_bar_segment" />

                    <View
                        android:id="@+id/strengthBar4"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_strength_bar_segment" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStrengthLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter password"
                    android:textColor="@color/ws_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPasswordRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="Use 8+ characters with a letter, number &amp; symbol."
                android:textColor="@color/ws_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvNewPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="12dp"
                android:textColor="@color/ws_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Confirm New Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.08"
                android:text="CONFIRM NEW PASSWORD"
                android:textColor="@color/ws_text2"
                android:textSize="10sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp">

                <EditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:hint="Re-enter new password"
                    android:inputType="textPassword"
                    android:padding="13dp"
                    android:paddingEnd="46dp"
                    android:textColor="@color/ws_text"
                    android:textColorHint="@color/ws_muted"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnToggleConfirmPassword"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle confirm password visibility"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_eye" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvConfirmPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="18dp"
                android:textColor="@color/ws_error"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnUpdatePassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/ws_accent"
                android:padding="14dp"
                android:text="Update Password"
                android:textColor="@color/ws_on_brand"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
