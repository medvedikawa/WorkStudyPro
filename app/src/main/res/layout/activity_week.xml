<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ws_surface"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Header & Day Scroller (Fixed at Top) -->
    <LinearLayout
        android:id="@+id/topContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/ws_surface"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Weekly Schedule"
                android:textColor="@color/ws_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnEditWeekSchedule"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="Edit"
                android:textColor="@color/ws_accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/horizontalScrollDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutDayContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <!-- Chips generated dynamically -->
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Day-by-Day Breakdown"
            android:textColor="@color/ws_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- Scrollable Timeline -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerWeekSchedule"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topContainer"
        android:layout_above="@id/bottomNavContainer"
        android:clipToPadding="false"
        android:padding="8dp" />

    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/today_nav_height"
        android:layout_alignParentBottom="true" />

</RelativeLayout>