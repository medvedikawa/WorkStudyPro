<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/ws_surface">

    <!-- Header & Day Scroller (Fixed at Top) -->
    <LinearLayout
        android:id="@+id/topContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/ws_surface"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="1dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Weekly Schedule"
                android:textColor="@color/ws_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnEditCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="Edit"
                android:textColor="@color/ws_accent"
                android:textSize="20sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground"
                android:padding="6dp" />

            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="📅"
                android:textSize="20sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/horizontalScrollDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutDayContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <!-- Chips generated dynamically -->
            </LinearLayout>
        </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Day-by-Day Breakdown"
            android:textColor="@color/ws_text"
            android:textSize="14sp"
            android:textStyle="bold"/>

    </LinearLayout>
    </LinearLayout>

    <!-- Bottom Navigation Bar (Fixed at Bottom) -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#14171F"
        android:orientation="horizontal"
        android:gravity="center"
        android:elevation="8dp">

        <TextView
            android:id="@+id/navToday"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🐸\nToday"
            android:textColor="@color/ws_text"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navWeek"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🐷\nWeek"
            android:textColor="@color/ws_accent"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/fabScanSchedule"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_accent_cirlce"
                android:src="@drawable/scann"
                app:tint="@color/ws_accent"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:contentDescription="Scan Schedule" />
        </FrameLayout>

        <TextView
            android:id="@+id/navTasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🐰\nTasks"
            android:textColor="@color/ws_text"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/navYou"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🦈\nYou"
            android:textColor="@color/ws_text"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Scrollable Timeline -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerWeekSchedule"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topContainer"
        android:layout_above="@id/bottomNavContainer"
        android:clipToPadding="false"
        android:padding="8dp" />

</RelativeLayout>