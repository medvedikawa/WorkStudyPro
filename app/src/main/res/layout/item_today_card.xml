<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_input"
    android:layout_marginBottom="8dp">

    <!-- Matches R.id.viewIndicator -->
    <View
        android:id="@+id/viewIndicator"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/ws_accent2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Matches R.id.tvScheduleTime -->
        <TextView
            android:id="@+id/tvScheduleTime"
            android:layout_width="110dp"
            android:layout_height="wrap_content"
            android:textColor="@color/ws_text"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <!-- Matches R.id.tvScheduleSubject -->
        <TextView
            android:id="@+id/tvScheduleSubject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ws_text"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</LinearLayout>