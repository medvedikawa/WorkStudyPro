<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- Header: Category Chip + Collision/Urgency Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvCategoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📝 Task Performance"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/ws_text"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvPriorityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#1 PRIORITY"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/ws_error"
            android:background="@drawable/bg_too"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Main Title & Checkbox -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/cbComplete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/ws_accent"
            android:layout_marginEnd="6dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAssignmentTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Database ERD Submission"
                android:textColor="@color/ws_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAssignmentSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Database Systems"
                android:textColor="@color/ws_accent"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDeleteAssignment"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/ws_muted"
            android:contentDescription="Delete Assignment" />
    </LinearLayout>

    <!-- Due Date & Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏰ Due: "
            android:textColor="@color/ws_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvDueDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oct 28, 2026 • 11:59 PM"
            android:textColor="@color/ws_text2"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Work Shift Collision / Urgency Reason Callout -->
    <LinearLayout
        android:id="@+id/layoutReasonBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_input"
        android:padding="8dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPriorityReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚨 Work shift collision on WED! Recommended to finish early."
            android:textColor="@color/ws_warning"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
