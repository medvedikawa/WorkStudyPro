<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTaskRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_task_card_mockup"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:gravity="top">

    <!-- Circle Checkbox / Selection Toggle -->
    <FrameLayout
        android:id="@+id/frameTaskCheck"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_task_circle_check">

        <ImageView
            android:id="@+id/ivTaskCheck"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_task_check"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Task Title -->
        <TextView
            android:id="@+id/tvAssignmentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chapter 4 System Architecture ERD"
            android:textColor="@color/task_ink"
            android:textSize="16sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp" />

        <!-- Meta (e.g. "Database Systems · School") -->
        <TextView
            android:id="@+id/tvTaskMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Database Systems · School"
            android:textColor="@color/task_muted"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <!-- Due Date with Clock Icon -->
        <LinearLayout
            android:id="@+id/layoutTaskDue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/ivTaskClock"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_task_clock"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvDueDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Today, 11:59 PM"
                android:textColor="@color/task_muted"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tags Row: Classification/Priority Tag + Importance Tag + Conflict Tag -->
        <LinearLayout
            android:id="@+id/layoutTaskTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <!-- Priority / Classification Tag (Critical, Urgent, Not Urgent, Minor) -->
            <TextView
                android:id="@+id/tvPriorityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_critical"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:text="Critical"
                android:textColor="@color/task_tag_crit_txt"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- User-Set Importance Tag (High, Mid, Low) -->
            <TextView
                android:id="@+id/tvImportanceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tag_mid"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:text="Mid"
                android:textColor="@color/task_tag_mid_txt"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Conflict Tag -->
            <LinearLayout
                android:id="@+id/layoutConflictTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tag_conf"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="9dp"
                android:paddingVertical="4dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_task_warn"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvConflictLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Conflicts with work"
                    android:textColor="@color/task_tag_conf_txt"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Kebab / 3 dots menu button -->
    <ImageButton
        android:id="@+id/btnTaskMenu"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_task_dots"
        android:contentDescription="Options" />

</LinearLayout>
