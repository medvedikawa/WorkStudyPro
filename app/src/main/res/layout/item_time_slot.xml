<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvBlockTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/schedule_block_title_initial"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnDeleteSlot"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/schedule_block_delete"
            app:tint="@color/ws_accent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutTypeSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/btnTypeSchool"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎓 Class"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/ws_on_brand"
            android:background="@drawable/bg_toggle_selected"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:minHeight="44dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnTypeWork"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💼 Work"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted"
            android:background="@drawable/bg_toggle_unselected"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:minHeight="44dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSlotFlags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/brand_raspberry"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etRowSubject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Subject or Shift Name (e.g. IT 301 or Barista)"
        android:textSize="16sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:background="@drawable/bg_input"
        android:padding="12dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvSubjectError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ws_error"
        android:textSize="12sp"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/daySelector"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/btnWeekdays"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="44dp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="@string/schedule_weekdays"
            android:textColor="@color/ws_accent"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnEveryDay"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="44dp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="@string/schedule_every_day"
            android:textColor="@color/ws_accent"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnClearDays"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="44dp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="@string/schedule_clear_days"
            android:textColor="@color/ws_accent"
            android:textSize="12sp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="6dp">

            <EditText
                android:id="@+id/etRowStart"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:hint="Start"
                android:textColorHint="@color/text_muted"
                android:clickable="true"
                android:focusable="false"
                android:inputType="none" />

            <TextView
                android:id="@+id/tvStartError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ws_error"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etRowEnd"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:hint="End"
                android:textColorHint="@color/text_muted"
                android:clickable="true"
                android:focusable="false"
                android:inputType="none" />

            <TextView
                android:id="@+id/tvEndError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ws_error"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvScheduleSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvScheduleError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/ws_error"
        android:textSize="12sp"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/layoutColorPalette"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎨 Color:"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <FrameLayout
            android:id="@+id/wrapperColor1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp">
            <View
                android:id="@+id/viewColor1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_circle" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/wrapperColor2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp">
            <View
                android:id="@+id/viewColor2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_circle" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/wrapperColor3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp">
            <View
                android:id="@+id/viewColor3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_circle" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/wrapperColor4"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp">
            <View
                android:id="@+id/viewColor4"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_circle" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/wrapperColor5"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp">
            <View
                android:id="@+id/viewColor5"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_circle" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/wrapperColor6"
            android:layout_width="32dp"
            android:layout_height="32dp">
            <View
                android:id="@+id/viewColor6"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_circle" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
