<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="8dp"
    android:layout_marginBottom="10dp">

    <EditText
        android:id="@+id/etRowSubject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Subject"
        android:textSize="19sp"
        android:textColorHint="@color/ws_muted"
        android:layout_marginBottom="6dp"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Category Container -->
        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:hint="Work"/>

    <!-- Day Input (e.g. M, W, F) -->
    <Spinner
        android:id="@+id/sDay"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:hint="Day"/>

    <!-- Start Time Input -->
    <EditText
        android:id="@+id/etRowStart"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@drawable/bg_input"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:hint="Start Time"
        android:textColorHint="#505868"
        android:clickable="true"
        android:focusable="false"
        android:inputType="none"
        android:layout_marginEnd="8dp" />

    <!-- End Time Input -->
    <EditText
        android:id="@+id/etRowEnd"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@drawable/bg_input"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="19sp"
        android:hint="End Time"
        android:textColorHint="#505868"
        android:clickable="true"
        android:focusable="false"
        android:inputType="none"
        android:layout_marginEnd="8dp" />

    <!-- Delete Button -->
    <ImageView
        android:id="@+id/btnDeleteSlot"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_delete"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete Slot"
        app:tint="#FF6B47" />
    </LinearLayout>

</LinearLayout>