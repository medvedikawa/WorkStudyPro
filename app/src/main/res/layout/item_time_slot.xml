<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_schedule_entry"
    android:padding="13dp"
    android:layout_marginHorizontal="3dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:id="@+id/layoutCardHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tvBlockTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/schedule_block_title_initial"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="OK"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/ivExpandIndicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="3dp"
            android:padding="3dp"
            android:src="@drawable/ic_schedule_expand"
            android:contentDescription="Expand schedule entry" />
    </LinearLayout>
    <TextView
        android:id="@+id/tvScheduleSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:ellipsize="end"
        android:maxLines="2"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp" />
    <TextView
        android:id="@+id/tvConflictReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/brand_raspberry"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginTop="4dp" />
    <TextView
        android:id="@+id/tvCrossTabWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:background="@drawable/bg_schedule_warning"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_marginTop="6dp" />
    <TextView
        android:id="@+id/tvSlotFlags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/brand_raspberry"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginTop="4dp" />
    <LinearLayout
        android:id="@+id/layoutExpandedFields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <EditText
            android:id="@+id/etRowSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Subject or shift name"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:background="@drawable/bg_input"
            android:padding="12dp"
            android:layout_marginTop="10dp" />
        <TextView
            android:id="@+id/tvSubjectError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ws_error"
            android:textSize="12sp"
            android:visibility="gone" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:drawableStart="@drawable/ic_schedule_days"
            android:drawablePadding="5dp"
            android:drawableTint="@color/ws_accent"
            android:text="Days · drag across to select"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />
        <LinearLayout
            android:id="@+id/daySelector"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="3dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/btnWeekdays"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="44dp"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="@string/schedule_weekdays"
                android:textColor="@color/ws_accent"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/btnEveryDay"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="44dp"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="@string/schedule_every_day"
                android:textColor="@color/ws_accent"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />
            <TextView
                android:id="@+id/btnClearDays"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="44dp"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="@string/schedule_clear_days"
                android:textColor="@color/ws_accent"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_schedule_clock"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/ws_accent"
                    android:text="Starts"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="3dp" />
                <EditText
                    android:id="@+id/etRowStart"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:hint="Start"
                    android:textColorHint="@color/text_muted"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true" />
                <TextView
                    android:id="@+id/tvStartError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ws_error"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_schedule_clock"
                    android:drawablePadding="4dp"
                    android:drawableTint="@color/ws_accent"
                    android:text="Ends"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="3dp" />
                <EditText
                    android:id="@+id/etRowEnd"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:hint="End"
                    android:textColorHint="@color/text_muted"
                    android:inputType="none"
                    android:focusable="false"
                    android:clickable="true" />
                <TextView
                    android:id="@+id/tvEndError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ws_error"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/tvScheduleError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ws_error"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginTop="4dp" />
        <LinearLayout
            android:id="@+id/layoutColorPalette"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_schedule_palette"
                android:drawablePadding="4dp"
                android:drawableTint="@color/ws_accent"
                android:text="Color:"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />
            <FrameLayout android:id="@+id/wrapperColor1" android:layout_width="32dp" android:layout_height="32dp"><View android:id="@+id/viewColor1" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:background="@drawable/bg_color_circle" /></FrameLayout>
            <FrameLayout android:id="@+id/wrapperColor2" android:layout_width="32dp" android:layout_height="32dp"><View android:id="@+id/viewColor2" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:background="@drawable/bg_color_circle" /></FrameLayout>
            <FrameLayout android:id="@+id/wrapperColor3" android:layout_width="32dp" android:layout_height="32dp"><View android:id="@+id/viewColor3" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:background="@drawable/bg_color_circle" /></FrameLayout>
            <FrameLayout android:id="@+id/wrapperColor4" android:layout_width="32dp" android:layout_height="32dp"><View android:id="@+id/viewColor4" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:background="@drawable/bg_color_circle" /></FrameLayout>
            <FrameLayout android:id="@+id/wrapperColor5" android:layout_width="32dp" android:layout_height="32dp"><View android:id="@+id/viewColor5" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:background="@drawable/bg_color_circle" /></FrameLayout>
            <FrameLayout android:id="@+id/wrapperColor6" android:layout_width="32dp" android:layout_height="32dp"><View android:id="@+id/viewColor6" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:background="@drawable/bg_color_circle" /></FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <TextView
                android:id="@+id/btnAddAnotherTime"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_schedule_add"
                android:drawablePadding="4dp"
                android:drawableTint="@color/ws_accent"
                android:text="Add another time"
                android:textColor="@color/ws_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_schedule_action"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="5dp" />
            <TextView
                android:id="@+id/btnDeleteSlot"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:gravity="center"
                android:drawableStart="@drawable/ic_schedule_delete"
                android:drawablePadding="4dp"
                android:drawableTint="@color/brand_raspberry"
                android:text="Remove class"
                android:textColor="@color/brand_raspberry"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_schedule_remove"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="5dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
