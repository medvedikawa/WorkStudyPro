<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:id="@+id/tvAssignmentDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Task"
            android:textColor="@color/text_primary"
            android:textSize="23sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvAssignmentDialogSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/task_dialog_subtitle"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TASK CATEGORY"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- Three Categories: School, Work, Other -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/chipCategorySchool"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:background="@drawable/bg_toggle_selected"
                android:gravity="center"
                android:text="@string/schedule_school"
                android:textColor="@color/ws_on_brand"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipCategoryWork"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_toggle_unselected"
                android:gravity="center"
                android:text="@string/schedule_work"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipCategoryOther"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_toggle_unselected"
                android:gravity="center"
                android:text="@string/task_category_other"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Importance Selector: High, Mid, Low -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/task_importance"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/chipImportanceHigh"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:background="@drawable/bg_toggle_unselected"
                android:gravity="center"
                android:text="@string/task_importance_high"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipImportanceMid"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_toggle_selected"
                android:gravity="center"
                android:text="@string/task_importance_mid"
                android:textColor="@color/ws_on_brand"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipImportanceLow"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_toggle_unselected"
                android:gravity="center"
                android:text="@string/task_importance_low"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Title Input ("Task title") -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TASK TITLE"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etAssignmentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:hint="e.g. Chapter 4 System Architecture ERD"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:padding="12dp"
            android:inputType="textCapSentences"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:id="@+id/layoutSubjectSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Subject Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COURSE / SUBJECT"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilAssignmentSubject"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:boxStrokeColor="@color/ws_accent"
                app:endIconMode="dropdown_menu">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/etAssignmentSubject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. Database Systems"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Due Date & Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <!-- Calendar Picker Button -->
            <LinearLayout
                android:id="@+id/btnPickDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 DUE DATE"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Date"
                    android:textColor="@color/ws_accent"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Clock Picker Button -->
            <LinearLayout
                android:id="@+id/btnPickTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏰ DUE TIME"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11:59 PM"
                    android:textColor="@color/ws_accent"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Reminder & Recurrence Section -->
        <CheckBox
            android:id="@+id/cbEnableReminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_reminder_enable"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:buttonTint="@color/ws_accent"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutReminderDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:id="@+id/btnPickReminderTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_reminder_time"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedReminderTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_reminder_time_default"
                    android:textColor="@color/ws_accent"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbRepeatWeekly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/task_repeat_weekly"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:buttonTint="@color/ws_accent"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layoutRecurringDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/task_recurring_days"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4">

                    <CheckBox android:id="@+id/cbMon" android:text="@string/task_day_mon" android:textColor="@color/text_primary" android:textSize="14sp" android:buttonTint="@color/ws_accent"/>
                    <CheckBox android:id="@+id/cbTue" android:text="@string/task_day_tue" android:textColor="@color/text_primary" android:textSize="14sp" android:buttonTint="@color/ws_accent"/>
                    <CheckBox android:id="@+id/cbWed" android:text="@string/task_day_wed" android:textColor="@color/text_primary" android:textSize="14sp" android:buttonTint="@color/ws_accent"/>
                    <CheckBox android:id="@+id/cbThu" android:text="@string/task_day_thu" android:textColor="@color/text_primary" android:textSize="14sp" android:buttonTint="@color/ws_accent"/>
                    <CheckBox android:id="@+id/cbFri" android:text="@string/task_day_fri" android:textColor="@color/text_primary" android:textSize="14sp" android:buttonTint="@color/ws_accent"/>
                    <CheckBox android:id="@+id/cbSat" android:text="@string/task_day_sat" android:textColor="@color/text_primary" android:textSize="14sp" android:buttonTint="@color/ws_accent"/>
                    <CheckBox android:id="@+id/cbSun" android:text="@string/task_day_sun" android:textColor="@color/text_primary" android:textSize="14sp" android:buttonTint="@color/ws_accent"/>
                </GridLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveAssignment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_save"
            android:textColor="@color/ws_on_brand"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/ws_accent"
            android:padding="14dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCancelAssignment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_discard"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:backgroundTint="@android:color/transparent" />

    </LinearLayout>
</ScrollView>
