<resources>
    <style name="WS" parent="@android:style/TextAppearance" />

    <style name="Theme.WSPro.Today" parent="Theme.WSPro">
        <item name="android:fontFamily">@font/atkinson_hyperlegible_next</item>
        <item name="fontFamily">@font/atkinson_hyperlegible_next</item>
    </style>

    <style name="WS.Title">
        <item name="android:fontFamily">@font/atkinson_hyperlegible_next_semibold</item>
        <item name="fontFamily">@font/atkinson_hyperlegible_next_semibold</item>
        <item name="android:textSize">@dimen/ws_title_size</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="WS.CardTitle">
        <item name="android:fontFamily">@font/atkinson_hyperlegible_next_semibold</item>
        <item name="fontFamily">@font/atkinson_hyperlegible_next_semibold</item>
        <item name="android:textSize">@dimen/ws_card_title_size</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="WS.Item">
        <item name="android:fontFamily">@font/atkinson_hyperlegible_next_medium</item>
        <item name="fontFamily">@font/atkinson_hyperlegible_next_medium</item>
        <item name="android:textSize">@dimen/ws_item_size</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="WS.Value">
        <item name="android:fontFamily">@font/atkinson_hyperlegible_next_regular</item>
        <item name="fontFamily">@font/atkinson_hyperlegible_next_regular</item>
        <item name="android:textSize">@dimen/ws_value_size</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="WS.Link">
        <item name="android:fontFamily">@font/atkinson_hyperlegible_next_regular</item>
        <item name="fontFamily">@font/atkinson_hyperlegible_next_regular</item>
        <item name="android:textSize">@dimen/ws_link_size</item>
        <item name="android:textColor">@color/brand_purple</item>
    </style>
    <style name="WS.Caption">
        <item name="android:fontFamily">@font/atkinson_hyperlegible_next_regular</item>
        <item name="fontFamily">@font/atkinson_hyperlegible_next_regular</item>
        <item name="android:textSize">@dimen/ws_caption_size</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>
    <style name="WS.Micro">
        <item name="android:fontFamily">@font/atkinson_hyperlegible_next_regular</item>
        <item name="fontFamily">@font/atkinson_hyperlegible_next_regular</item>
        <item name="android:textSize">@dimen/ws_micro_size</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>
    <style name="WS.Rank">
        <item name="android:fontFamily">@font/atkinson_hyperlegible_next_semibold</item>
        <item name="fontFamily">@font/atkinson_hyperlegible_next_semibold</item>
        <item name="android:textSize">@dimen/today_task_rank_text</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="WS.NavActive">
        <item name="android:fontFamily">@font/atkinson_hyperlegible_next_medium</item>
        <item name="fontFamily">@font/atkinson_hyperlegible_next_medium</item>
        <item name="android:textSize">@dimen/ws_micro_size</item>
        <item name="android:textColor">@color/brand_purple</item>
    </style>
</resources>
