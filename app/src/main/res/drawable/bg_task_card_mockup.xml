<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/task_card_sel" />
            <stroke android:width="1.5dp" android:color="@color/task_violet" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/task_card_sel" />
            <stroke android:width="1.5dp" android:color="@color/task_violet" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/ws_surface" />
            <stroke android:width="1.5dp" android:color="@color/task_line" />
        </shape>
    </item>
</selector>
